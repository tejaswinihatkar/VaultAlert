# ─────────────────────────────────────────────────────────────────────────────
# VaultAlert — Environment Variables Template
# Copy this to .env and fill in your values before running docker-compose.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME=VaultAlert
APP_ENV=development                        # development | staging | production
DEBUG=true
SECRET_KEY=CHANGE_THIS_TO_A_RANDOM_64_CHAR_SECRET

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=vaultalert
POSTGRES_USER=vaultalert_admin
POSTGRES_PASSWORD=CHANGE_THIS_POSTGRES_PASSWORD
DATABASE_URL=postgresql+asyncpg://vaultalert_admin:CHANGE_THIS_POSTGRES_PASSWORD@postgres:5432/vaultalert

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_THIS_REDIS_PASSWORD
REDIS_URL=redis://:CHANGE_THIS_REDIS_PASSWORD@redis:6379/0

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── MQTT Broker ───────────────────────────────────────────────────────────────
MQTT_BROKER_HOST=mosquitto
MQTT_BROKER_PORT=1883
MQTT_USERNAME=vaultalert_server
MQTT_PASSWORD=CHANGE_THIS_MQTT_PASSWORD
MQTT_CLIENT_ID=vaultalert_backend

# ── AWS S3 ────────────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=ap-south-1
AWS_S3_BUCKET=vaultalert-media

# ── Firebase Cloud Messaging ──────────────────────────────────────────────────
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_PRIVATE_KEY_ID=your_firebase_private_key_id
FIREBASE_PRIVATE_KEY=your_firebase_private_key
FIREBASE_CLIENT_EMAIL=your_firebase_client_email

# ── SMTP (Email) ──────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=alerts@vaultalert.io
SMTP_PASSWORD=CHANGE_THIS_SMTP_PASSWORD
SMTP_FROM_NAME=VaultAlert Security

# ── Twilio (SMS) ─────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+1234567890

# ── AI Engine ─────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key
AI_FACE_CONFIDENCE_THRESHOLD=0.85
AI_THREAT_SCORE_ALERT_LEVEL=0.7

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,https://app.vaultalert.io

# ── Frontend (Next.js) ────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
NEXT_PUBLIC_APP_NAME=VaultAlert
