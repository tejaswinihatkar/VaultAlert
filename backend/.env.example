# VaultAlert — Backend Environment Variables Example
# Copy this file to .env and fill in your values

# ─── Database ────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://vaultalert:vaultalert@localhost:5432/vaultalert

# ─── Redis ───────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── JWT Security ────────────────────────────────────
SECRET_KEY=change-this-to-a-random-64-char-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── MQTT Broker ─────────────────────────────────────
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# ─── Telegram Integration ────────────────────────────
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
TELEGRAM_CHAT_ID=your-group-chat-id-here

# ─── AWS S3 Storage (optional) ───────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
S3_BUCKET_NAME=vaultalert-media

# ─── Google Gemini AI (optional) ─────────────────────
GEMINI_API_KEY=

# ─── Email SMTP ──────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ─── App Settings ────────────────────────────────────
ENVIRONMENT=development
DEBUG=true
CORS_ORIGINS=http://localhost:3000
